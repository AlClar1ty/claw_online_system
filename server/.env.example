# Salin berkas ini menjadi .env, lalu isi nilainya.
# Jangan commit .env. Server Key tidak boleh masuk ke firmware atau halaman web.

PORT=3000

# Server Key sandbox ada di dashboard Midtrans: Settings > Access Keys.
# Sandbox memakai kunci yang diawali SB-Mid-server.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# gopay atau airpay shopee
MIDTRANS_QRIS_ACQUIRER=gopay

# Opsional. Isi dengan URL publik HTTPS jika webhook diteruskan lewat tunnel.
# Contoh: https://nama.ngrok-free.app/api/midtrans/notification
# Halaman client tetap bisa mendeteksi settlement lewat pengecekan status,
# jadi URL ini boleh dikosongkan saat uji di komputer yang sama.
MIDTRANS_NOTIFICATION_URL=

PAYMENT_EXPIRY_MINUTES=15

# String acak, minimal 24 karakter.
JWT_SECRET=

# Harus sama persis dengan DEVICE_TOKEN di firmware/include/config.h.
# Beberapa papan: pisahkan dengan koma, tanpa spasi.
DEVICE_TOKEN=

# Akun ini dibuat sekali, hanya bila database belum punya admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# true hanya jika halaman dibuka lewat HTTPS.
COOKIE_SECURE=false

# DB_PATH=data/app.db
