# Salin berkas ini menjadi .env, lalu isi nilainya.
# Jangan commit .env. Server Key tidak boleh masuk ke firmware atau halaman web.

PORT=3000

# Server Key sandbox ada di dashboard Midtrans: Settings > Access Keys.
# Sandbox memakai kunci yang diawali SB-Mid-server.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# Untuk uji di simulator sandbox pakai airpay shopee.
# gopay memakai data merchant akun asli, dan simulator sering membalas
# error 116 merchant not found.
MIDTRANS_QRIS_ACQUIRER=airpay shopee

# Opsional. Isi dengan URL publik HTTPS jika webhook diteruskan lewat tunnel.
# Contoh: https://nama.ngrok-free.app/api/midtrans/notification
# Halaman client tetap bisa mendeteksi settlement lewat pengecekan status,
# jadi URL ini boleh dikosongkan saat uji di komputer yang sama.
MIDTRANS_NOTIFICATION_URL=

PAYMENT_EXPIRY_MINUTES=15

# String acak, minimal 24 karakter.
JWT_SECRET=

# Dipakai hanya jika sinyal masih diambil perangkat lain lewat HTTP.
# Saat LOCAL_RELAY=true, nilai ini tidak menggerakkan GPIO.
DEVICE_TOKEN=

# Akun ini dibuat sekali, hanya bila database belum punya admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# true hanya jika halaman dibuka lewat HTTPS.
COOKIE_SECURE=false

# DB_PATH=data/app.db

# true: Raspberry Pi ini yang menutup kontak relay lewat GPIO.
# false: antrean diambil lewat HTTP /api/machine/jobs.
LOCAL_RELAY=false

# Nomor BCM. Pin fisik 11 pada header 40 pin adalah BCM 17.
# Jangan memakai GPIO 0 atau 1.
RELAY_GPIO=17

# false: kontak menutup saat pin LOW. Modul Songle 2 kanal di proyek ini begitu.
# true hanya jika modul menutup kontak saat pin HIGH.
RELAY_ACTIVE_HIGH=false

# Lama kontak tertutup, lalu jeda sebelum main berikutnya. Satuan milidetik.
RELAY_ON_MS=80
RELAY_GAP_MS=200
